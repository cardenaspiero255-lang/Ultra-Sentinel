# EXAMPLE ONLY. Install as /etc/ultra-sentinel/watchdog.env mode 0600 (owned root).
# NEVER commit live credentials; rotate when exposed.
ULTRA_SENTINEL_SENTRY_ORG=your-sentry-organization-slug
ULTRA_SENTINEL_SENTRY_PROJECT_ID=123456
ULTRA_SENTINEL_SENTRY_TOKEN=REPLACE_WITH_READ_ONLY_SENTRY_TOKEN
ULTRA_SENTINEL_READONLY_GITHUB_TOKEN=REPLACE_WITH_READ_ONLY_GITHUB_TOKEN
ULTRA_SENTINEL_ALERT_WEBHOOK_URL=https://alerts.example.org/ultra-sentinel
ULTRA_SENTINEL_ALERT_AUTH_TOKEN=REPLACE_WITH_LONG_WEBHOOK_AUTH_SECRET
ULTRA_SENTINEL_ALERT_SIGNING_SECRET=REPLACE_WITH_DISTINCT_LONG_HMAC_SECRET
