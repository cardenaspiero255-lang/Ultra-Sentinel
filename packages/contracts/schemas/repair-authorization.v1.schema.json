{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultra-sentinel.invalid/contracts/repair-authorization.v1.schema.json",
  "title": "repair-authorization",
  "description": "Versioned inert wire contract; no runtime is currently deployed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "repository",
    "prNumber",
    "headSha",
    "actor",
    "scope",
    "expiresAt",
    "nonce"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "REPAIR_COMMITS_AUTHORIZED"
    },
    "repository": {
      "type": "string",
      "maxLength": 150,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "prNumber": {
      "type": "integer",
      "minimum": 1
    },
    "headSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      },
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "attestationId": {
      "type": "string",
      "maxLength": 128
    }
  }
}
